# Alpaca Markets API (server-side REST calls)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret

# Alpaca Markets API (client-side WebSocket streaming)
# NOTE: These are exposed to the browser. Use a read-only market data key.
NEXT_PUBLIC_ALPACA_API_KEY=your_alpaca_api_key
NEXT_PUBLIC_ALPACA_API_SECRET=your_alpaca_api_secret

# Supabase (public — safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase (server-only — never expose)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
